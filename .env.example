# Copy to .env (same folder as start.sh) and fill in. .env is not stored in git.
# The Anthropic API key is normally entered on the site's Settings page (stored in the
# keychain). Setting it here instead overrides the page, e.g. on a server:
# ANTHROPIC_API_KEY=sk-ant-...

# Optional
# CHAT_MODEL=claude-opus-5-5     # model for the chat
# CHAT_EFFORT=high               # low | medium | high | xhigh | max
# CHAT_CODE_TIMEOUT=300          # seconds the assistant's code may run
# OLLAMA_MODEL=qwen3:8b          # local model for setup suggestions and the report
